setclipboard("https://discord.gg/4cy7tpTHND")

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "UpdateNotice"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local message = Instance.new("TextLabel")
message.Size = UDim2.fromOffset(500, 80)
message.Position = UDim2.new(0.5, -250, 0.4, 0)
message.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
message.BackgroundTransparency = 0.3
message.BorderSizePixel = 0
message.Text = "This script is broken.\nGrab the latest FileGarden version from the #scripts channel.\n(Discord invite copied to your clipboard.)"
message.TextColor3 = Color3.new(1, 1, 1)
message.TextSize = 18
message.Font = Enum.Font.Gotham
message.TextWrapped = true
message.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = message

local outline = Instance.new("UIStroke")
outline.Color = Color3.fromRGB(255, 50, 50)
outline.Thickness = 2
outline.Parent = message

local ding = Instance.new("Sound")
ding.SoundId = "rbxassetid://5852311745"
ding.Volume = 1
ding.Parent = gui
ding:Play()

ding.Ended:Once(function()
	ding:Destroy()
end)

task.delay(5, function()
	local fade = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	TweenService:Create(message, fade, {
		TextTransparency = 1,
		BackgroundTransparency = 1,
	}):Play()

	TweenService:Create(outline, fade, {
		Transparency = 1,
	}):Play()

	task.wait(1.5)
	gui:Destroy()
end)
